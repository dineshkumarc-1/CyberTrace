# Copy to .env. Never commit real credentials.
DATABASE_URL=postgresql://cybertrace:CHANGE_ME@localhost:5432/cybertrace
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cybertrace
# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ORIGIN=http://localhost:3000
EMBEDDING_URL=http://127.0.0.1:8001
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Set these only when running db:seed. Do not use real passwords in Git.
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
# Restrict server-to-server embedding service to localhost/private network.

# Docker bootstrap passwords (must match the connection URLs above):
POSTGRES_PASSWORD=
MONGO_PASSWORD=
