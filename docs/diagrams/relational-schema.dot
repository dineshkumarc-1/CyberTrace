digraph S { graph [rankdir=LR,bgcolor="white",pad=.4,nodesep=.45,ranksep=.8,label="CyberTrace | Physical PostgreSQL schema",labelloc=t,fontname="Arial",fontsize=24]; node [shape=plain,fontname="Arial"]; edge [color="#8393ab",arrowsize=.65];
app_users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c8d6e8"><TR><TD BGCOLOR="#e5edfa"><B>app_users</B></TD></TR><TR><TD ALIGN="LEFT">user_id : uuid [PK]</TD></TR><TR><TD ALIGN="LEFT">name : text</TD></TR><TR><TD ALIGN="LEFT">email : text</TD></TR><TR><TD ALIGN="LEFT">password_hash : text</TD></TR><TR><TD ALIGN="LEFT">role : text</TD></TR><TR><TD ALIGN="LEFT">active : boolean</TD></TR><TR><TD ALIGN="LEFT">token_version : integer</TD></TR><TR><TD ALIGN="LEFT">created_at : timestamptz</TD></TR></TABLE>>];
incidents [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c8d6e8"><TR><TD BGCOLOR="#e5edfa"><B>incidents</B></TD></TR><TR><TD ALIGN="LEFT">incident_id : uuid [PK]</TD></TR><TR><TD ALIGN="LEFT">title : text</TD></TR><TR><TD ALIGN="LEFT">description : text</TD></TR><TR><TD ALIGN="LEFT">severity : text</TD></TR><TR><TD ALIGN="LEFT">status : text</TD></TR><TR><TD ALIGN="LEFT">detected_at : timestamptz</TD></TR><TR><TD ALIGN="LEFT">created_at : timestamptz</TD></TR><TR><TD ALIGN="LEFT">updated_at : timestamptz</TD></TR><TR><TD ALIGN="LEFT">created_by : uuid [FK]</TD></TR><TR><TD ALIGN="LEFT">assigned_to : uuid [FK]</TD></TR><TR><TD ALIGN="LEFT">archived : boolean</TD></TR><TR><TD ALIGN="LEFT">version : integer</TD></TR></TABLE>>];
assets [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c8d6e8"><TR><TD BGCOLOR="#e5edfa"><B>assets</B></TD></TR><TR><TD ALIGN="LEFT">asset_id : uuid [PK]</TD></TR><TR><TD ALIGN="LEFT">asset_name : text</TD></TR><TR><TD ALIGN="LEFT">asset_type : text</TD></TR><TR><TD ALIGN="LEFT">criticality : text</TD></TR><TR><TD ALIGN="LEFT">owner_name : text</TD></TR><TR><TD ALIGN="LEFT">location : text</TD></TR></TABLE>>];
vulnerabilities [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c8d6e8"><TR><TD BGCOLOR="#e5edfa"><B>vulnerabilities</B></TD></TR><TR><TD ALIGN="LEFT">vulnerability_id : uuid [PK]</TD></TR><TR><TD ALIGN="LEFT">cve_id : text</TD></TR><TR><TD ALIGN="LEFT">name : text</TD></TR><TR><TD ALIGN="LEFT">severity : text</TD></TR><TR><TD ALIGN="LEFT">description : text</TD></TR><TR><TD ALIGN="LEFT">published_date : date</TD></TR></TABLE>>];
attack_techniques [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c8d6e8"><TR><TD BGCOLOR="#e5edfa"><B>attack_techniques</B></TD></TR><TR><TD ALIGN="LEFT">technique_id : uuid [PK]</TD></TR><TR><TD ALIGN="LEFT">technique_name : text</TD></TR><TR><TD ALIGN="LEFT">mitre_id : text</TD></TR><TR><TD ALIGN="LEFT">description : text</TD></TR></TABLE>>];
incident_assets [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c8d6e8"><TR><TD BGCOLOR="#e5edfa"><B>incident_assets</B></TD></TR><TR><TD ALIGN="LEFT">incident_id : uuid [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">asset_id : uuid [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">impact : text</TD></TR><TR><TD ALIGN="LEFT">relationship_details : text</TD></TR></TABLE>>];
incident_vulnerabilities [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c8d6e8"><TR><TD BGCOLOR="#e5edfa"><B>incident_vulnerabilities</B></TD></TR><TR><TD ALIGN="LEFT">incident_id : uuid [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">vulnerability_id : uuid [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">discovered_at : timestamptz</TD></TR><TR><TD ALIGN="LEFT">details : text</TD></TR></TABLE>>];
incident_techniques [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c8d6e8"><TR><TD BGCOLOR="#e5edfa"><B>incident_techniques</B></TD></TR><TR><TD ALIGN="LEFT">incident_id : uuid [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">technique_id : uuid [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">observed_at : timestamptz</TD></TR><TR><TD ALIGN="LEFT">details : text</TD></TR></TABLE>>];
remediations [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c8d6e8"><TR><TD BGCOLOR="#e5edfa"><B>remediations</B></TD></TR><TR><TD ALIGN="LEFT">remediation_id : uuid [PK]</TD></TR><TR><TD ALIGN="LEFT">incident_id : uuid [FK]</TD></TR><TR><TD ALIGN="LEFT">action : text</TD></TR><TR><TD ALIGN="LEFT">description : text</TD></TR><TR><TD ALIGN="LEFT">status : text</TD></TR><TR><TD ALIGN="LEFT">completed_at : timestamptz</TD></TR><TR><TD ALIGN="LEFT">version : integer</TD></TR></TABLE>>];
incident_status_history [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c8d6e8"><TR><TD BGCOLOR="#e5edfa"><B>incident_status_history</B></TD></TR><TR><TD ALIGN="LEFT">history_id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">incident_id : uuid [FK]</TD></TR><TR><TD ALIGN="LEFT">old_status : text</TD></TR><TR><TD ALIGN="LEFT">new_status : text</TD></TR><TR><TD ALIGN="LEFT">changed_by : uuid [FK]</TD></TR><TR><TD ALIGN="LEFT">changed_at : timestamptz</TD></TR></TABLE>>];
embedding_sources [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c8d6e8"><TR><TD BGCOLOR="#e5edfa"><B>embedding_sources</B></TD></TR><TR><TD ALIGN="LEFT">source_type : text [PK]</TD></TR><TR><TD ALIGN="LEFT">source_id : text [PK]</TD></TR><TR><TD ALIGN="LEFT">incident_id : uuid [FK]</TD></TR><TR><TD ALIGN="LEFT">version : integer</TD></TR></TABLE>>];
embedding_jobs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c8d6e8"><TR><TD BGCOLOR="#e5edfa"><B>embedding_jobs</B></TD></TR><TR><TD ALIGN="LEFT">job_id : bigint [PK]</TD></TR><TR><TD ALIGN="LEFT">source_type : text</TD></TR><TR><TD ALIGN="LEFT">source_id : text</TD></TR><TR><TD ALIGN="LEFT">incident_id : uuid [FK]</TD></TR><TR><TD ALIGN="LEFT">source_version : integer</TD></TR><TR><TD ALIGN="LEFT">status : text</TD></TR><TR><TD ALIGN="LEFT">attempts : integer</TD></TR><TR><TD ALIGN="LEFT">error : text</TD></TR><TR><TD ALIGN="LEFT">updated_at : timestamptz</TD></TR></TABLE>>];
incident_embeddings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c8d6e8"><TR><TD BGCOLOR="#e5edfa"><B>incident_embeddings</B></TD></TR><TR><TD ALIGN="LEFT">embedding_id : uuid [PK]</TD></TR><TR><TD ALIGN="LEFT">incident_id : uuid [FK]</TD></TR><TR><TD ALIGN="LEFT">source_type : text</TD></TR><TR><TD ALIGN="LEFT">source_id : text</TD></TR><TR><TD ALIGN="LEFT">source_version : integer</TD></TR><TR><TD ALIGN="LEFT">chunk_index : integer</TD></TR><TR><TD ALIGN="LEFT">content_text : text</TD></TR><TR><TD ALIGN="LEFT">embedding : vector(384)</TD></TR><TR><TD ALIGN="LEFT">model_name : text</TD></TR><TR><TD ALIGN="LEFT">updated_at : timestamptz</TD></TR></TABLE>>];
incidents->app_users;
incident_assets->incidents;
incident_assets->assets;
incident_vulnerabilities->incidents;
