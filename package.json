{
  "name": "cybertrace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/setup.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "evaluate": "tsx scripts/evaluate.ts",
    "embeddings": "node embeddings/server.mjs",
    "test:services": "tsx scripts/local-test-services.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@huggingface/transformers": "^4.3.1",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.8",
    "jose": "6.2.12",
    "mongodb": "7.7.0",
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
